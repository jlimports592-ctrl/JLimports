rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // PRODUTOS:
    // - Catálogo público: qualquer visitante pode ver os produtos
    // - Somente o Administrador autenticado pode criar, editar ou excluir
    match /produtos/{produtoId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // FINANCEIRO:
    // - Apenas usuário autenticado (Admin) tem permissão de leitura e escrita
    match /financeiro/{registroId} {
      allow read, write: if request.auth != null;
    }

  }
}
